{
  "name": "shaki-music-player",
  "version": "1.0.0",
  "description": "SHAKI MUSIC - Premium desktop music player",
  "main": "electron/main.cjs",
  "author": "SHAKI",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "electron": "electron .",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "22.3.27",
    "electron-builder": "^24.13.3",
    "vite": "^4.5.14"
  },
  "build": {
    "appId": "com.shaki.musicplayer",
    "productName": "SHAKI MUSIC",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "asar": true,
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "artifactName": "SHAKI-MUSIC-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SHAKI MUSIC"
    }
  }
}